{
	"name": "@ramarivera/pi-goal",
	"version": "0.1.5",
	"description": "Pi extension that adds Codex-style persisted goals and hidden continuation pressure.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ramarivera/pi-goal.git"
	},
	"homepage": "https://github.com/ramarivera/pi-goal#readme",
	"bugs": {
		"url": "https://github.com/ramarivera/pi-goal/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"docs",
		"skills",
		"openspec/changes/add-pi-goal",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"goal",
		"goal-loop",
		"continuation"
	],
	"scripts": {
		"test": "tsx --test test/**/*.test.ts",
		"test:live": "PI_GOAL_LIVE=1 tsx --test --test-force-exit test/pi-goal-live-model.test.ts",
		"typecheck": "npm exec --package typescript -- tsc --noEmit",
		"lint": "npm run typecheck"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@mariozechner/pi-ai": "*",
		"@mariozechner/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@mariozechner/pi-ai": "^0.72.1",
		"@mariozechner/pi-coding-agent": "^0.72.1",
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"pino": "^10.3.1"
	}
}
